# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only. Required for the Stripe webhook to provision
# users + organisations from Payment Link checkouts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key — only required if you use the AI lesson plan generator
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key

# Site URL — used in webhook redirect URLs and magic-link `redirectTo`. Falls
# back to https://crestio.ai if unset.
NEXT_PUBLIC_SITE_URL=https://crestio.ai

# Stripe — auth + webhook
STRIPE_SECRET_KEY=sk_test_or_sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs per plan tier × billing interval. Test + live ID values
# live in .env.local (not committed). Keep both sets ready to swap when
# moving between modes.
STRIPE_PRICE_SOLO_MONTHLY=price_...
STRIPE_PRICE_SOLO_ANNUAL=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_ANNUAL=price_...

# Payment Link mode — 'test' or 'live'. Drives which set of Payment Link URLs
# the pricing page uses (URLs themselves live in lib/stripe/payment-links.ts,
# populated by scripts/create-payment-links.ts).
NEXT_PUBLIC_STRIPE_LINK_MODE=test

# Optional — set to 'true' if Stripe Tax is configured on the account. The
# create-payment-links script reads this to enable automatic_tax on each link.
STRIPE_AUTOMATIC_TAX=false

# Resend — transactional email delivery (welcome email, parent invitations,
# notifications). Sender domain must be verified.
RESEND_API_KEY=re_...
